<mujoco model="ur5e">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast" timestep="0.002">
    <flag contact="enable"/>
  </option>

  <size nconmax="200" njmax="500"/>

  <default>
    <default class="ur5e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <general gaintype="fixed" biastype="affine" ctrlrange="-6.2831 6.2831"
        gainprm="2000" biasprm="0 -2000 -400" forcerange="-150 150"/>
      <default class="size3">
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size1">
        <general gainprm="500" biasprm="0 -500 -100" forcerange="-28 28"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <!-- Arm body geoms: conaffinity=0 — never collide with corridor walls -->
      <default class="collision">
        <geom type="capsule" group="3" contype="1" conaffinity="0"/>
        <default class="eef_collision">
          <geom type="cylinder" contype="1" conaffinity="0"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <material class="ur5e" name="black"     rgba="0.033 0.033 0.033 1"/>
    <material class="ur5e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur5e" name="linkgray"  rgba="0.82 0.82 0.82 1"/>
    <material class="ur5e" name="urblue"    rgba="0.49 0.678 0.8 1"/>
    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="wrist_2_link" pos="0 -1 2"/>

    <!-- ── UR5e Arm ───────────────────────────────────────────────────────── -->
    <body name="base" quat="0 0 0 -1" childclass="ur5e">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072"/>
      <geom mesh="base_0" material="black"     class="visual"/>
      <geom mesh="base_1" material="jointgray" class="visual"/>
      <body name="shoulder_link" pos="0 0 0.163">
        <inertial mass="3.7" pos="0 0 0" diaginertia="0.0102675 0.0102675 0.00666"/>
        <joint name="shoulder_pan_joint" class="size3" axis="0 0 1"/>
        <geom mesh="shoulder_0" material="urblue"    class="visual"/>
        <geom mesh="shoulder_1" material="black"     class="visual"/>
        <geom mesh="shoulder_2" material="jointgray" class="visual"/>
        <geom name="shoulder_col" class="collision" size="0.06 0.06" pos="0 0 -0.04"/>
        <body name="upper_arm_link" pos="0 0.138 0" quat="1 0 1 0">
          <inertial mass="8.393" pos="0 0 0.2125" diaginertia="0.133886 0.133886 0.0151074"/>
          <joint name="shoulder_lift_joint" class="size3"/>
          <geom mesh="upperarm_0" material="linkgray"  class="visual"/>
          <geom mesh="upperarm_1" material="black"     class="visual"/>
          <geom mesh="upperarm_2" material="jointgray" class="visual"/>
          <geom mesh="upperarm_3" material="urblue"    class="visual"/>
          <geom name="upperarm_col0" class="collision" pos="0 -0.04 0" quat="1 1 0 0" size="0.06 0.06"/>
          <geom name="upperarm_col1" class="collision" size="0.05 0.2"  pos="0 0 0.2"/>
          <body name="forearm_link" pos="0 -0.131 0.425">
            <inertial mass="2.275" pos="0 0 0.196" diaginertia="0.0311796 0.0311796 0.004095"/>
            <joint name="elbow_joint" class="size3_limited"/>
            <geom mesh="forearm_0" material="urblue"    class="visual"/>
            <geom mesh="forearm_1" material="linkgray"  class="visual"/>
            <geom mesh="forearm_2" material="black"     class="visual"/>
            <geom mesh="forearm_3" material="jointgray" class="visual"/>
            <geom name="forearm_col0" class="collision" pos="0 0.08 0" quat="1 1 0 0" size="0.055 0.06"/>
            <geom name="forearm_col1" class="collision" size="0.038 0.19" pos="0 0 0.2"/>
            <body name="wrist_1_link" pos="0 0 0.392" quat="1 0 1 0">
              <inertial mass="1.219" pos="0 0.127 0" diaginertia="0.0025599 0.0025599 0.0021942"/>
              <joint name="wrist_1_joint" class="size1"/>
              <geom mesh="wrist1_0" material="black"     class="visual"/>
              <geom mesh="wrist1_1" material="urblue"    class="visual"/>
              <geom mesh="wrist1_2" material="jointgray" class="visual"/>
              <geom name="wrist1_col" class="collision" pos="0 0.05 0" quat="1 1 0 0" size="0.04 0.07"/>
              <body name="wrist_2_link" pos="0 0.127 0">
                <inertial mass="1.219" pos="0 0 0.1" diaginertia="0.0025599 0.0025599 0.0021942"/>
                <joint name="wrist_2_joint" axis="0 0 1" class="size1"/>
                <geom mesh="wrist2_0" material="black"     class="visual"/>
                <geom mesh="wrist2_1" material="urblue"    class="visual"/>
                <geom mesh="wrist2_2" material="jointgray" class="visual"/>
                <geom name="wrist2_col0" class="collision" size="0.04 0.06" pos="0 0 0.04"/>
                <geom name="wrist2_col1" class="collision" pos="0 0.02 0.1" quat="1 1 0 0" size="0.04 0.04"/>
                <body name="wrist_3_link" pos="0 0 0.1">
                  <inertial mass="0.1889" pos="0 0.0771683 0" quat="1 0 0 1"
                    diaginertia="0.000132134 9.90863e-05 9.90863e-05"/>
                  <joint name="wrist_3_joint" class="size1"/>
                  <geom material="linkgray" mesh="wrist3" class="visual"/>
                  <geom name="eef_col" class="eef_collision" pos="0 0.08 0" quat="1 1 0 0" size="0.04 0.02"/>
                  <site name="attachment_site" pos="0 0.1 0" quat="-1 1 0 0"/>

                  <!-- Touch probe — mimics piezo sensor on real arm.
                       radius=4mm, total length=160mm.
                       contype=1 conaffinity=1: collides with wall geoms only
                       (arm geoms have conaffinity=0 so no arm-wall contacts). -->
                  <body name="touch_probe" pos="0 0.1 0" quat="-1 1 0 0">
                    <geom name="probe" type="cylinder"
                      size="0.004 0.080"
                      rgba="1 0.5 0 1"
                      contype="1" conaffinity="1"
                      condim="3" friction="0.3 0.1 0.1"
                      mass="0.05"/>
                    <site name="probe_tip" pos="0 0 0.080" size="0.005" rgba="1 1 0 1"/>
                  </body>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ════════════════════════════════════════════════════════════════════
         VERTICAL S-SHAPED CORRIDOR
         All dimensions verified. No STL — pure box geoms.

         corridor body world pos: (0.32, -0.03, 0.05)

         Top-down local layout:

              ● GREEN  x=-0.030, y=+0.100  (centred in seg1)
              |
         [seg1]  x=[-0.043, -0.017], width=18mm, runs y: -0.010 to +0.135
              |
         [turn1] corner connector at y=0.000
              |
         [seg2]  y=[-0.043, -0.017], horizontal, runs x: -0.043 to +0.043
              |
         [turn2] corner connector at x=+0.030
              |
         [seg3]  x=[+0.017, +0.043], width=18mm, runs y: -0.043 to -0.133
              |
              ● RED    x=+0.030, y=-0.115  (centred in seg3)

         Corridor width: 18mm
         Probe diameter:  8mm
         Clearance/side:  5mm  → real wall contacts on turns
         Wall height:    70mm (top at world Z=0.12m, probe tip at ~0.054m
                               → probe cylinder fully inside wall zone)

         Lego build (match these dims physically):
           Wall rows: 1 stud wide (8mm)
           Gap between rows: ~2.5 studs (18-20mm)
           Seg1: ~17 studs long (135mm)
           Cross: ~10 studs wide (80mm)
           Seg3: ~11 studs long (90mm)
         ════════════════════════════════════════════════════════════════ -->

    <body name="corridor" pos="0.32 -0.03 0.05">

      <!-- Segment 1: top vertical channel, centred at x=-0.030 -->
      <!-- s1_left:  outer left wall,  inner face at x=-0.039 -->
      <!-- s1_right: inner right wall, inner face at x=-0.021 -->
      <geom name="s1_left"  type="box" pos="-0.0430  0.0625 0.0350" size="0.0040 0.0765 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>
      <geom name="s1_right" type="box" pos="-0.0170  0.0625 0.0350" size="0.0040 0.0765 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>
      <geom name="s1_top"   type="box" pos="-0.0300  0.1390 0.0350" size="0.0170 0.0040 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>

      <!-- Segment 2: horizontal cross channel, centred at y=-0.030 -->
      <!-- s2_top: inner top wall, inner face at y=-0.021 -->
      <!-- s2_bot: outer bot wall, inner face at y=-0.039 -->
      <geom name="s2_top"   type="box" pos=" 0.0000 -0.0170 0.0350" size="0.0600 0.0040 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>
      <geom name="s2_bot"   type="box" pos=" 0.0000 -0.0430 0.0350" size="0.0600 0.0040 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>

      <!-- Segment 3: bottom vertical channel, centred at x=+0.030 -->
      <!-- s3_left:  inner left wall, inner face at x=+0.021 -->
      <!-- s3_right: outer right wall, inner face at x=+0.039 -->
      <geom name="s3_left"  type="box" pos=" 0.0170 -0.0880 0.0350" size="0.0040 0.0490 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>
      <geom name="s3_right" type="box" pos=" 0.0430 -0.0880 0.0350" size="0.0040 0.0490 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>
      <geom name="s3_bot"   type="box" pos=" 0.0300 -0.1370 0.0350" size="0.0170 0.0040 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>

      <!-- Corner connectors — fill the turn gaps -->
      <geom name="c1"       type="box" pos="-0.0300 -0.0010 0.0350" size="0.0170 0.0040 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>
      <geom name="c2"       type="box" pos=" 0.0300 -0.0430 0.0350" size="0.0170 0.0040 0.0350" rgba="0.75 0.75 0.75 1" contype="1" conaffinity="1"/>

      <!-- Floor: conaffinity=2 so it does NOT collide with probe (conaffinity=1)
           This prevents floor contacts being logged as wall collisions.
           The floor is purely to visually ground the corridor. -->
      <geom name="s_floor"  type="box" pos="0.000 0.000 -0.004" size="0.070 0.155 0.004"
        rgba="0.35 0.35 0.35 1" contype="2" conaffinity="2"/>

      <!-- GREEN = start, centred in seg1 channel. x=-0.030 is equidistant
           from both walls (5mm clearance each side with 4mm probe radius). -->
      <site name="goal"  pos="-0.030  0.100 0.035" size="0.010" rgba="0 1 0 1" group="1"/>
      <!-- RED = goal, centred in seg3 channel. -->
      <site name="start" pos=" 0.030 -0.115 0.035" size="0.010" rgba="1 0 0 1" group="1"/>

    </body>

  </worldbody>

  <actuator>
    <general class="size3"         name="shoulder_pan"  joint="shoulder_pan_joint"/>
    <general class="size3"         name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="size3_limited" name="elbow"         joint="elbow_joint"/>
    <general class="size1"         name="wrist_1"       joint="wrist_1_joint"/>
    <general class="size1"         name="wrist_2"       joint="wrist_2_joint"/>
    <general class="size1"         name="wrist_3"       joint="wrist_3_joint"/>
  </actuator>

  <!-- Touch sensor: maps directly to piezo on real arm.
       Read with: data.sensor('probe_force').data[0]  (Newtons) -->
  <sensor>
    <touch name="probe_force" site="probe_tip"/>
  </sensor>

  <!-- Home keyframe: probe tip centred in seg1 at green site.
       Read from viewer after manual positioning.
       These match HOME_QPOS in q_learning.py — keep in sync. -->
  <keyframe>
    <key name="home"
      qpos="0.754 -1.45 -2.8 -1.76 -4.59 -2.07"
      ctrl="0.754 -1.45 -2.8 -1.76 -4.59 -2.07"/>
  </keyframe>

</mujoco>